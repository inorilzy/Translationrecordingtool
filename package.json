{
  "name": "translation-tool",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:dictionary": "python scripts/build_dictionary.py",
    "ocr:models": "node scripts/prepare_ocr_models.mjs",
    "ocr:models:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare_ocr_models.ps1",
    "ocr:ort:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare_ort_runtime.ps1",
    "ocr:ort": "node scripts/prepare_ort_runtime.mjs",
    "tauri:build:ocr": "npm run tauri:build:ocr:native",
    "tauri:build:ocr:native": "npm run ocr:models:win -- -Profile small && npm run ocr:ort:win && tauri build --config src-tauri/tauri.ocr-native.conf.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "node scripts/rust-test.mjs test",
    "check:rust": "node scripts/rust-test.mjs check --tests",
    "test:rust-wrapper": "node --test scripts/rust-test.test.mjs",
    "test:dependencies": "node --test scripts/dependency-smoke.test.mjs",
    "verify:final": "node scripts/verify-s06.mjs",
    "tauri": "tauri",
    "tauri:build:ocr:mac": "npm run ocr:models && npm run ocr:ort && tauri build --config src-tauri/tauri.ocr-native.macos.conf.json && node scripts/package_macos.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@unocss/reset": "^66.7.2",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.42",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^25.6.0",
    "@unocss/preset-uno": "^66.7.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^4.1.12",
    "@vue/test-utils": "^2.4.8",
    "jsdom": "^29.0.2",
    "typescript": "~5.6.2",
    "unocss": "^66.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.1.10"
  }
}
