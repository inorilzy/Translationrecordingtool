{
  "_comment": "SYNTHETIC 共享负例：对 synthetic-valid.json 施加变更后必须被拒绝，且错误信息包含 expectError。Python 与 PowerShell 测试都读取本文件。path 中字符串为对象键、整数为数组下标。",
  "mutationCases": [
    { "name": "顶层未知字段", "ops": [{ "op": "set", "path": ["extra"], "value": 1 }], "expectError": "$: unknown field 'extra'" },
    { "name": "缺 schemaVersion", "ops": [{ "op": "remove", "path": ["schemaVersion"] }], "expectError": "$: missing field 'schemaVersion'" },
    { "name": "schemaVersion 不支持", "ops": [{ "op": "set", "path": ["schemaVersion"], "value": 2 }], "expectError": "$.schemaVersion: unsupported schemaVersion" },
    { "name": "schemaVersion 为字符串", "ops": [{ "op": "set", "path": ["schemaVersion"], "value": "1" }], "expectError": "$.schemaVersion: unsupported schemaVersion" },
    { "name": "synthetic 为 false", "ops": [{ "op": "set", "path": ["synthetic"], "value": false }], "expectError": "$.synthetic: must be true when present" },
    { "name": "assets 为空", "ops": [{ "op": "set", "path": ["assets"], "value": [] }], "expectError": "$.assets: must not be empty" },
    { "name": "assets 非数组", "ops": [{ "op": "set", "path": ["assets"], "value": {} }], "expectError": "$.assets: must be an array" },
    { "name": "未知 kind", "ops": [{ "op": "set", "path": ["assets", 0, "kind"], "value": "plugin" }], "expectError": "$.assets[0].kind: unknown kind 'plugin'" },
    { "name": "条目未知字段", "ops": [{ "op": "set", "path": ["assets", 0, "note"], "value": "x" }], "expectError": "$.assets[0]: unknown field 'note'" },
    { "name": "条目缺 approval", "ops": [{ "op": "remove", "path": ["assets", 0, "approval"] }], "expectError": "$.assets[0]: missing field 'approval'" },
    { "name": "id 与 identity 不符", "ops": [{ "op": "set", "path": ["assets", 0, "id"], "value": "ocr-model/small/rec" }], "expectError": "$.assets[0].id: must equal 'ocr-model/small/det'" },
    { "name": "重复 id", "ops": [{ "op": "copy", "from": ["assets", 0], "path": ["assets", 1] }], "expectError": "$.assets[1].id: duplicate asset id 'ocr-model/small/det'" },
    { "name": "模型 profile 未支持", "ops": [{ "op": "set", "path": ["assets", 0, "identity", "profile"], "value": "lite" }], "expectError": "$.assets[0].identity.profile: must be one of: tiny, small, medium" },
    { "name": "模型 role 未支持", "ops": [{ "op": "set", "path": ["assets", 0, "identity", "role"], "value": "cls" }], "expectError": "$.assets[0].identity.role: must be one of: det, rec" },
    { "name": "模型 repo 被替换", "ops": [{ "op": "set", "path": ["assets", 0, "identity", "repo"], "value": "attacker/PP-OCRv6_small_det_onnx" }], "expectError": "$.assets[0].identity.repo: must equal 'PaddlePaddle/PP-OCRv6_small_det_onnx'" },
    { "name": "模型 revision 为可变引用", "ops": [{ "op": "set", "path": ["assets", 0, "identity", "revision"], "value": "main" }], "expectError": "$.assets[0].identity.revision: must match 40-character lowercase hex commit" },
    { "name": "模型 revision 大写", "ops": [{ "op": "set", "path": ["assets", 0, "identity", "revision"], "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }], "expectError": "$.assets[0].identity.revision: must match 40-character lowercase hex commit" },
    { "name": "模型 identity 未知字段", "ops": [{ "op": "set", "path": ["assets", 0, "identity", "branch"], "value": "main" }], "expectError": "$.assets[0].identity: unknown field 'branch'" },
    { "name": "模型缺 yml", "ops": [{ "op": "remove", "path": ["assets", 0, "files", 2] }], "expectError": "$.assets[0].files: missing required file 'inference.yml'" },
    { "name": "模型额外文件", "ops": [{ "op": "set", "path": ["assets", 0, "files", 2, "name"], "value": "extra.bin" }], "expectError": "$.assets[0].files[2].name: unexpected file 'extra.bin'" },
    { "name": "模型重复文件", "ops": [{ "op": "copy", "from": ["assets", 0, "files", 0], "path": ["assets", 0, "files", 1] }], "expectError": "$.assets[0].files[1].name: duplicate file 'inference.onnx'" },
    { "name": "模型 URL 指向 main", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "url"], "value": "https://huggingface.co/PaddlePaddle/PP-OCRv6_small_det_onnx/resolve/main/inference.onnx" }], "expectError": "$.assets[0].files[0].url: must equal" },
    { "name": "文件缺 sha256", "ops": [{ "op": "remove", "path": ["assets", 0, "files", 0, "sha256"] }], "expectError": "$.assets[0].files[0]: missing field 'sha256'" },
    { "name": "sha256 过短", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "sha256"], "value": "1111" }], "expectError": "$.assets[0].files[0].sha256: must match 64-character lowercase hex" },
    { "name": "sha256 大写", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "sha256"], "value": "ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB" }], "expectError": "$.assets[0].files[0].sha256: must match 64-character lowercase hex" },
    { "name": "sha256 带末尾换行", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "sha256"], "value": "1111111111111111111111111111111111111111111111111111111111111111\n" }], "expectError": "$.assets[0].files[0].sha256: must match 64-character lowercase hex" },
    { "name": "size 为 0", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "size"], "value": 0 }], "expectError": "$.assets[0].files[0].size: must be a positive integer" },
    { "name": "size 为负", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "size"], "value": -1 }], "expectError": "$.assets[0].files[0].size: must be a positive integer" },
    { "name": "size 为小数", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "size"], "value": 1.5 }], "expectError": "$.assets[0].files[0].size: must be a positive integer" },
    { "name": "size 为字符串", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "size"], "value": "101" }], "expectError": "$.assets[0].files[0].size: must be a positive integer" },
    { "name": "size 为布尔", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "size"], "value": true }], "expectError": "$.assets[0].files[0].size: must be a positive integer" },
    { "name": "文件未知字段", "ops": [{ "op": "set", "path": ["assets", 0, "files", 0, "mirror"], "value": "https://example.invalid/x" }], "expectError": "$.assets[0].files[0]: unknown field 'mirror'" },
    { "name": "审批状态 pending", "ops": [{ "op": "set", "path": ["assets", 0, "approval", "status"], "value": "pending" }], "expectError": "$.assets[0].approval.status: must be one of: approved" },
    { "name": "缺审批人", "ops": [{ "op": "remove", "path": ["assets", 0, "approval", "approvedBy"] }], "expectError": "$.assets[0].approval: missing field 'approvedBy'" },
    { "name": "审批人为空白", "ops": [{ "op": "set", "path": ["assets", 0, "approval", "approvedBy"], "value": "  " }], "expectError": "$.assets[0].approval.approvedBy: must be a non-empty string" },
    { "name": "审批日期非法", "ops": [{ "op": "set", "path": ["assets", 0, "approval", "approvedAt"], "value": "2026-02-30" }], "expectError": "$.assets[0].approval.approvedAt: must be a valid calendar date" },
    { "name": "审批日期格式错", "ops": [{ "op": "set", "path": ["assets", 0, "approval", "approvedAt"], "value": "22/10/2026" }], "expectError": "$.assets[0].approval.approvedAt: must match YYYY-MM-DD" },
    { "name": "证据为空", "ops": [{ "op": "set", "path": ["assets", 0, "approval", "evidence"], "value": [] }], "expectError": "$.assets[0].approval.evidence: must not be empty" },
    { "name": "证据非字符串", "ops": [{ "op": "set", "path": ["assets", 0, "approval", "evidence"], "value": [1] }], "expectError": "$.assets[0].approval.evidence[0]: must be a string" },
    { "name": "审批未知字段", "ops": [{ "op": "set", "path": ["assets", 0, "approval", "autoApprove"], "value": true }], "expectError": "$.assets[0].approval: unknown field 'autoApprove'" },
    { "name": "ORT 版本非 semver", "ops": [{ "op": "set", "path": ["assets", 2, "identity", "version"], "value": "latest" }], "expectError": "$.assets[2].identity.version: must match MAJOR.MINOR.PATCH" },
    { "name": "ORT 架构未支持", "ops": [{ "op": "set", "path": ["assets", 2, "identity", "arch"], "value": "arm64" }], "expectError": "$.assets[2].identity.arch: must be one of: x64" },
    { "name": "ORT 缺 DLL 条目", "ops": [{ "op": "remove", "path": ["assets", 2, "files", 1] }], "expectError": "$.assets[2].files: missing required file 'onnxruntime.dll'" },
    { "name": "ORT DLL 归档路径被改", "ops": [{ "op": "set", "path": ["assets", 2, "files", 1, "archivePath"], "value": "onnxruntime-win-x64-1.20.1/../evil.dll" }], "expectError": "$.assets[2].files[1].archivePath: must equal" },
    { "name": "ORT DLL 改为 URL 下载", "ops": [{ "op": "set", "path": ["assets", 2, "files", 1, "url"], "value": "https://example.invalid/onnxruntime.dll" }], "expectError": "$.assets[2].files[1]: unknown field 'url'" },
    { "name": "ORT zip URL 与版本不符", "ops": [{ "op": "set", "path": ["assets", 2, "files", 0, "url"], "value": "https://github.com/microsoft/onnxruntime/releases/download/v1.21.0/onnxruntime-win-x64-1.20.1.zip" }], "expectError": "$.assets[2].files[0].url: must equal" },
    { "name": "词典 source 未知", "ops": [{ "op": "set", "path": ["assets", 3, "identity", "source"], "value": "cedict" }], "expectError": "$.assets[3].identity.source: must be one of: ecdict, wordnet" },
    { "name": "ECDICT 缺 revision", "ops": [{ "op": "remove", "path": ["assets", 3, "identity", "revision"] }], "expectError": "$.assets[3].identity: missing field 'revision'" },
    { "name": "ECDICT revision 为 master", "ops": [{ "op": "set", "path": ["assets", 3, "identity", "revision"], "value": "master" }], "expectError": "$.assets[3].identity.revision: must match 40-character lowercase hex commit" },
    { "name": "ECDICT repo 被替换", "ops": [{ "op": "set", "path": ["assets", 3, "identity", "repo"], "value": "someone/ECDICT" }], "expectError": "$.assets[3].identity.repo: must equal 'skywind3000/ECDICT'" },
    { "name": "WordNet 带 ECDICT 字段", "ops": [{ "op": "set", "path": ["assets", 4, "identity", "revision"], "value": "cccccccccccccccccccccccccccccccccccccccc" }], "expectError": "$.assets[4].identity: unknown field 'revision'" },
    { "name": "WordNet 版本非法", "ops": [{ "op": "set", "path": ["assets", 4, "identity", "version"], "value": "3" }], "expectError": "$.assets[4].identity.version: must match MAJOR.MINOR" },
    { "name": "WordNet 文件名与版本不符", "ops": [{ "op": "set", "path": ["assets", 4, "files", 0, "name"], "value": "WNdb-3.1.tar.gz" }], "expectError": "$.assets[4].files[0].name: unexpected file 'WNdb-3.1.tar.gz'" }
  ],
  "rawCases": [
    { "name": "重复键", "text": "{\"schemaVersion\":1,\"schemaVersion\":1,\"synthetic\":true,\"assets\":[]}", "expectError": "duplicate key 'schemaVersion'" },
    { "name": "仅大小写不同的重复键", "text": "{\"schemaVersion\":1,\"SchemaVersion\":1,\"synthetic\":true,\"assets\":[]}", "expectError": "duplicate key 'SchemaVersion'" },
    { "name": "NaN 常量", "text": "{\"schemaVersion\":NaN,\"synthetic\":true,\"assets\":[]}", "expectError": "" },
    { "name": "非 JSON", "text": "not json", "expectError": "" },
    { "name": "顶层数组", "text": "[]", "expectError": "$: must be an object" }
  ]
}
